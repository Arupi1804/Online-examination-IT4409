{
  "name": "@online-exam/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include ../../packages/shared/dist src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/server/src/index.js",
    "test": "npm run build && node --test dist/apps/server/tests/realtime/gateway.test.js dist/apps/server/tests/realtime/worker.test.js",
    "check": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@online-exam/shared": "workspace:*",
    "express": "4.21.2",
    "express-session": "^1.18.2",
    "socket.io": "4.8.1",
    "ioredis": "^5.4.2",
    "redis": "4.7.0",
    "pg": "^8.13.0",
    "cors": "2.8.5",
    "helmet": "8.1.0",
    "dotenv": "16.5.0",
    "zod": "3.24.3",
    "@prisma/client": "6.7.0",
    "connect-redis": "8.0.2"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "tsx": "4.19.4",
    "prisma": "6.7.0",
    "@types/node": "^22.0.0",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.1",
    "@types/pg": "^8.11.0",
    "@types/cors": "2.8.17",
    "socket.io-client": "^4.8.1",
    "supertest": "7.1.0",
    "@types/supertest": "6.0.2"
  }
}