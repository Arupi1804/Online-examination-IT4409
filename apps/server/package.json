{
  "name": "@online-exam/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && tsx watch --include ../../packages/shared/dist src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate"
  },
  "dependencies": {
    "@online-exam/shared": "workspace:*",
    "@prisma/client": "6.7.0",
    "bcryptjs": "3.0.2",
    "connect-redis": "8.0.2",
    "cors": "2.8.5",
    "dotenv": "16.5.0",
    "express": "4.21.2",
    "express-session": "1.18.1",
    "helmet": "8.1.0",
    "redis": "4.7.0",
    "socket.io": "4.8.1",
    "zod": "3.24.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/express-session": "1.18.1",
    "@types/supertest": "6.0.2",
    "prisma": "6.7.0",
    "socket.io-client": "4.8.1",
    "supertest": "7.1.0",
    "tsx": "4.19.4"
  }
}
