{
  "name": "online-examination",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.19.0 <21",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "pnpm --filter @online-exam/shared build && concurrently -k -n shared,server,client \"pnpm --filter @online-exam/shared dev\" \"pnpm --filter @online-exam/server dev\" \"pnpm --filter @online-exam/client dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @online-exam/shared build && pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm --filter @online-exam/shared build && vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "infra:up": "docker compose up -d postgres redis",
    "infra:stop": "docker compose stop postgres redis"
  },
  "devDependencies": {
    "@eslint/js": "9.25.1",
    "eslint": "9.25.1",
    "typescript-eslint": "8.31.1",
    "eslint-config-prettier": "10.1.2",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.0.0",
    "prettier": "3.5.3",
    "typescript": "5.8.3",
    "concurrently": "9.1.2",
    "vitest": "3.1.2",
    "@playwright/test": "1.51.1",
    "@types/node": "20.17.30"
  }
}
